{
  "id": "/",
  "name": "AME Balance Care",
  "short_name": "Balance Care",
  "description": "Balance hídrico gratuito para enfermería, disponible sin conexión tras la instalación.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f6f8f6",
